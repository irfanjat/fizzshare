# Copy to .env (or export in your shell / Docker Compose env).
# TURN_SHARED_SECRET is REQUIRED for relay support. It must match coturn's
# static-auth-secret exactly. If left empty, the server issues no TURN creds
# and clients run STUN-only (good for the "why TURN fails" demo).

HOST=0.0.0.0
PORT=8080
PUBLIC_URL=http://localhost:8080

# Comma-separated list of allowed Origins for the WebSocket handshake.
# When empty (dev), any Origin is accepted. In production set to your domain.
ORIGINS=http://localhost:8080,http://127.0.0.1

# Room lifetime, sweep cadence, and max peers per room.
ROOM_TTL_SEC=900
SWEEP_INTERVAL_SEC=30
ROOM_MAX_PEERS=2
ROOM_CODE_LENGTH=6

# WebSocket max payload. SDP w/ trickle ICE is small; 1 MiB is generous.
WS_MAX_PAYLOAD_BYTES=1048576

# --- TURN / STUN ---
TURN_HOSTNAME=localhost
TURN_SHARED_SECRET=
TURN_STUN_PORT=3478
TURN_UDP_PORT=3478
TURN_TLS_PORT=5349
# Validity window of issued TURN credentials (should be >= ROOM_TTL_SEC).
TURN_LIFETIME_SEC=3600

# --- Rate limiting ---
MSG_RATE_PER_MIN=600
JOIN_RATE_PER_MIN=8
JOIN_FAIL_LOCK_MS=60000
MAX_JOIN_FAILS=5

# --- Ops ---
LOG_LEVEL=info