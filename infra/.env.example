# ── peershare deployment env — copy to infra/.env and edit ───────────────────
# Never commit the filled-in .env. The Dockerfiles contain NO secrets; the
# shared secret is passed to coturn on the command line at runtime only.

# Domain browsers will use. MUST resolve to this server for BOTH:
#   - Caddy:  :80/:443
#   - coturn: 3478/udp+tcp (STUN/TURN), 5349/tcp (turns:), 49160-49200/udp (relay)
# Local testing without DNS: PUBLIC_HOST=localhost (Caddy serves plain HTTP,
# which is still a secure context for WebRTC on localhost).
PUBLIC_HOST=peershare.example.com

# Caddy site address.
#   production:  peershare.example.com        (Caddy auto-provisions ACME certs)
#   local demo:  localhost:80                 (no TLS, works in two browser tabs)
SITE_ADDRESS=peershare.example.com

# Comma-separated origins permitted by the signaling server's Origin check.
# Browsers send these; anything else gets RST. Prod: exactly your public origin.
ORIGINS=https://peershare.example.com,http://localhost

# Shared secret for TURN REST credentials: coturn validates HMAC-SHA1(secret,
# username) == credential, and signaling signs browser creds with this same
# value. Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=change-me-openssl-rand-hex-32

# coturn realm (session identity shown in TURN logs / SIP fidelity).
TURN_REALM=peershare.local

# Seconds each issued TURN credential stays valid.
TURN_LIFETIME_SEC=3600

# Server log verbosity.
LOG_LEVEL=info